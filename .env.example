# MindMesh AI environment configuration
# Never commit real API keys or production secrets.

# ─────────────────────────────────────────────
# Supabase + pgvector (Streamlit RAG)
# ─────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=replace-with-supabase-publishable-key

# ─────────────────────────────────────────────
# LLM providers
# ─────────────────────────────────────────────
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Gemini provider
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────
# Embeddings / RAG
# ─────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=5

# Audio/video transcription
WHISPER_MODEL=base

# ─────────────────────────────────────────────
# Existing FastAPI application
# ─────────────────────────────────────────────
SESSION_SECRET=generate-a-long-random-value
SESSION_HTTPS_ONLY=false
CORS_ORIGINS=http://localhost:8000

# Optional Telegram monitoring
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
